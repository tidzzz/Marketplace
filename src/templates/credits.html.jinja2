{% extends "layout.html.jinja2" %}

{% block title %}My Credits - IMT Marketplace{% endblock %}

{% block content %}
<div class="container mt-4">
    <h2 class="mb-4">My Credits</h2>

    <div class="row">
        <!-- Left Column: Balance & Top Up -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted">Current Balance</h5>
                    <h2 class="display-4 text-primary fw-bold" id="current-balance">€0,00</h2>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Top Up Credits</h5>
                </div>
                <div class="card-body">
                    <form id="topup-form">
                        <div class="mb-3">
                            <label for="amount" class="form-label">Amount (€)</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input type="number" class="form-control" id="amount" min="1" step="0.01" required placeholder="10.00">
                            </div>
                            <div class="form-text">Minimum €1.00</div>
                        </div>
                        <div id="topup-error" class="alert alert-danger d-none"></div>
                        <button type="submit" class="btn btn-success w-100">Add Credits</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Transaction History -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Transaction History</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody id="ledger-body">
                                <!-- Transactions will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                    <div id="loading-ledger" class="text-center p-3">
                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                    </div>
                    <div id="empty-ledger" class="text-center p-3 d-none text-muted">
                        No transactions found.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const email = localStorage.getItem('userEmail');
        if (!email) {
            window.location.href = '/login';
            return;
        }
        fetchLedger();
    });

    async function fetchLedger() {
        const email = localStorage.getItem('userEmail');
        try {
            const response = await fetch('/api/credits/ledger', {
                headers: { 'X-User-Email': email }
            });

            if (!response.ok) {
                if (response.status === 401) window.location.href = '/login';
                throw new Error('Failed to fetch ledger');
            }

            const data = await response.json();
            updateUI(data);
        } catch (error) {
            console.error(error);
            alert('Error loading credits info.');
        }
    }

    function updateUI(data) {
        // Update Balance
        document.getElementById('current-balance').textContent = formatMoney(data.balance_cents);

        // Update Ledger Table
        const tbody = document.getElementById('ledger-body');
        const loading = document.getElementById('loading-ledger');
        const empty = document.getElementById('empty-ledger');
        
        tbody.innerHTML = '';
        loading.classList.add('d-none');

        if (data.txns.length === 0) {
            empty.classList.remove('d-none');
            return;
        }

        data.txns.forEach(txn => {
            const tr = document.createElement('tr');
            
            // Format Date
            const date = new Date(txn.created_at).toLocaleString();
            
            // Format Type (Badge)
            let typeBadge = '';
            switch(txn.type) {
                case 'topup': typeBadge = '<span class="badge bg-success">Top Up</span>'; break;
                case 'purchase': typeBadge = '<span class="badge bg-danger">Purchase</span>'; break;
                case 'sale_payout': typeBadge = '<span class="badge bg-info text-dark">Sale</span>'; break;
                case 'refund': typeBadge = '<span class="badge bg-warning text-dark">Refund</span>'; break;
                default: typeBadge = `<span class="badge bg-secondary">${txn.type}</span>`;
            }

            // Format Amount Color
            const amountClass = txn.amount_cents >= 0 ? 'text-success' : 'text-danger';
            const amountSign = txn.amount_cents > 0 ? '+' : '';

            tr.innerHTML = `
                <td>${date}</td>
                <td>${typeBadge}</td>
                <td class="text-end ${amountClass} fw-bold">${amountSign}${formatMoney(txn.amount_cents)}</td>
                <td class="text-end text-muted">${formatMoney(txn.balance_after_cents)}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    // Top Up Logic
    document.getElementById('topup-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const email = localStorage.getItem('userEmail');
        const amountInput = document.getElementById('amount');
        const errorDiv = document.getElementById('topup-error');
        const btn = this.querySelector('button');

        const amountEur = parseFloat(amountInput.value);
        if (isNaN(amountEur) || amountEur <= 0) return;

        const amountCents = Math.round(amountEur * 100);

        btn.disabled = true;
        btn.textContent = 'Processing...';
        errorDiv.classList.add('d-none');

        try {
            const response = await fetch('/api/credits/topup', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Email': email
                },
                body: JSON.stringify({ amount_cents: amountCents })
            });

            if (response.ok) {
                amountInput.value = '';
                fetchLedger(); // Refresh data
                alert('Credits added successfully!');
            } else {
                const data = await response.json();
                throw new Error(data.error || 'Top up failed');
            }
        } catch (error) {
            errorDiv.textContent = error.message;
            errorDiv.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Add Credits';
        }
    });

    function formatMoney(cents) {
        return (cents / 100).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
    }
</script>
{% endblock %}
